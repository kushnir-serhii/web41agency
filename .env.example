# Public origin, no trailing slash. Example: https://web41agency.com
NEXT_PUBLIC_SITE_URL=
# Public contact email shown on the site and used in mailto links
NEXT_PUBLIC_CONTACT_EMAIL=

# --- AI chatbot (spec 004) ---
# Vercel: set all three in Project Settings > Environment Variables (Preview and Production).
# OpenAI API key. SERVER ONLY, never prefix with NEXT_PUBLIC_. If missing, the chat route returns 503.
OPENAI_API_KEY=
# OpenAI model id. SERVER ONLY. Small, fast non-reasoning chat model chosen in the OpenAI console. No hardcoded default.
OPENAI_MODEL=
# PUBLIC build-time kill switch. 'true' mounts the chat widget and enables the route.
# Inlined at build, so changing it in Vercel requires a redeploy.
NEXT_PUBLIC_CHAT_ENABLED=false

# --- Free Quote form -> Telegram (spec 005) ---
# Vercel: set both in Project Settings > Environment Variables (Preview and Production).
# Telegram bot token from @BotFather. SERVER ONLY, never prefix with NEXT_PUBLIC_, never log it. If missing, the route returns 503 and the form shows the mailto: fallback.
TELEGRAM_BOT_TOKEN=
# Telegram chat or group ID that receives leads (agency chat). The bot must be a member of it. SERVER ONLY. If missing, the route returns 503 and the form shows the mailto: fallback.
TELEGRAM_CHAT_ID=
